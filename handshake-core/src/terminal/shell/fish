status is-interactive; or return
set -g _handshake_active 0
function _handshake_preexec --on-event fish_preexec
    set -l command_hex (builtin printf '%s' "$argv[1]" | /usr/bin/od -An -v -tx1 | /usr/bin/tr -d ' \n')
    builtin printf '\033]133;C;handshake=@TOKEN@;command=%s\007' "$command_hex"
    set -g _handshake_active 1
end
function _handshake_postexec --on-event fish_postexec
    set -l result $status
    builtin printf '\033]133;D;handshake=@TOKEN@;%s\007' "$result"
    set -g _handshake_active 0
end
function _handshake_exit --on-event fish_exit
    set -l result $status
    if test $_handshake_active = 1
        builtin printf '\033]133;D;handshake=@TOKEN@;%s\007' "$result"
    end
end
function _handshake_prompt --on-event fish_prompt
    builtin printf '\033]133;A;handshake=@TOKEN@\007'
end
