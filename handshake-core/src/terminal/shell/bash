# The private login profile restored HOME. The system profile has already run.
for _handshake_profile in "$HOME/.bash_profile" "$HOME/.bash_login" "$HOME/.profile"; do
    if [[ -r $_handshake_profile ]]; then builtin source "$_handshake_profile"; break; fi
done
builtin unset _handshake_profile
[[ $- == *i* ]] || return
_handshake_active=0
_handshake_ready=0
_handshake_disabled=0
_handshake_metadata_available() {
    [[ -o history && ${HISTSIZE:-500} != 0 &&
       ${HISTCONTROL:-} != *ignorespace* && ${HISTCONTROL:-} != *ignoreboth* && -z ${HISTIGNORE:-} ]]
}
_handshake_prompt() {
    local result=$?
    (( _handshake_disabled )) && return "$result"
    _handshake_ready=0
    if (( _handshake_active )); then
        builtin printf '\033]133;D;handshake=@TOKEN@;%s\007' "$result"
        _handshake_active=0
    fi
    builtin printf '\033]133;A;handshake=@TOKEN@\007'
    return "$result"
}
_handshake_debug() {
    local result=$?
    (( _handshake_disabled )) && return "$result"
    [[ $BASH_COMMAND == _handshake_prompt || ${FUNCNAME[1]:-} == _handshake_prompt ]] && return "$result"
    if (( _handshake_ready && ! _handshake_active )); then
        if ! _handshake_metadata_available; then
            builtin printf '\033]133;L;handshake=@TOKEN@\007'
            _handshake_disabled=1
            _handshake_ready=0
            return "$result"
        fi
        _handshake_active=1
        _handshake_ready=0
        local line recent
        # The shell supplies this command metadata. Never read terminal echo/output.
        recent=$(HISTTIMEFORMAT= builtin history 1)
        line=${recent#*[0-9]  }
        if [[ -z $line ]]; then
            builtin printf '\033]133;L;handshake=@TOKEN@\007'
            _handshake_disabled=1
            _handshake_ready=0
            _handshake_active=0
            return "$result"
        fi
        local command_hex=$(builtin printf '%s' "$line" | /usr/bin/od -An -v -tx1 | /usr/bin/tr -d ' \n')
        builtin printf '\033]133;C;handshake=@TOKEN@;command=%s\007' "$command_hex"
    fi
    return "$result"
}
_handshake_exit() {
    local result=$?
    (( _handshake_active )) && builtin printf '\033]133;D;handshake=@TOKEN@;%s\007' "$result"
}
# Leave shells with existing DEBUG/EXIT traps on the lifetime-span fallback rather
# than replacing user hooks. PROMPT_COMMAND retains both strings and arrays.
if [[ -z $(builtin trap -p DEBUG) && -z $(builtin trap -p EXIT) ]] && _handshake_metadata_available; then
    if [[ $(builtin declare -p PROMPT_COMMAND 2>/dev/null) == 'declare -a'* ]]; then
        PROMPT_COMMAND=('_handshake_prompt' "${PROMPT_COMMAND[@]}" '_handshake_ready=1')
    else
        PROMPT_COMMAND="_handshake_prompt${PROMPT_COMMAND:+; $PROMPT_COMMAND}; _handshake_ready=1"
    fi
    builtin trap '_handshake_debug' DEBUG
    builtin trap '_handshake_exit' EXIT
fi
