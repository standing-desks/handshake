[[ -o interactive ]] || return
typeset -g _handshake_active=0
_handshake_preexec() {
    emulate -L zsh
    local command_hex=$(builtin printf '%s' "$1" | /usr/bin/od -An -v -tx1 | /usr/bin/tr -d ' \n')
    builtin printf '\033]133;C;handshake=@TOKEN@;command=%s\007' "$command_hex"
    _handshake_active=1
}
_handshake_precmd() {
    local result=$?
    if (( _handshake_active )); then
        builtin printf '\033]133;D;handshake=@TOKEN@;%s\007' "$result"
        _handshake_active=0
    fi
    builtin printf '\033]133;A;handshake=@TOKEN@\007'
    return $result
}
_handshake_exit() {
    local result=$?
    (( _handshake_active )) && builtin printf '\033]133;D;handshake=@TOKEN@;%s\007' "$result"
}
typeset -ga preexec_functions precmd_functions zshexit_functions
preexec_functions=(_handshake_preexec ${preexec_functions:#_handshake_preexec})
precmd_functions=(_handshake_precmd ${precmd_functions:#_handshake_precmd})
zshexit_functions+=(_handshake_exit)
